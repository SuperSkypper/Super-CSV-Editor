{
	"name": "super-csv-editor",
	"version": "0.0.4",
	"description": "Edit CSV files in a spreadsheet grid with fast cell editing and keyboard navigation.",
	"main": "main.js",
	"type": "module",
	"author": "SuperSkypper",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SuperSkypper/Super-CSV-Editor.git"
	},
	"homepage": "https://github.com/SuperSkypper/Super-CSV-Editor",
	"bugs": {
		"url": "https://github.com/SuperSkypper/Super-CSV-Editor/issues"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"deploy": "npm run build && node scripts/deploy.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "node --test \"src/**/*.test.ts\"",
		"test:vault": "node --test \"src/parser/vault.test.ts\"",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"csv",
		"spreadsheet",
		"table",
		"editor"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"@eslint/js": "9.30.1",
		"jiti": "2.6.1"
	},
	"dependencies": {
		"obsidian": "latest"
	},
	"overrides": {
		"moment": "^2.31.0"
	},
	"allowScripts": {
		"esbuild@0.25.5": true
	}
}
